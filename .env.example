# =============================================
#  THE CAKEWALK WITH TARUNA — Environment Vars
#  Copy this to .env and fill in your values
# =============================================

# Twilio Credentials (get from https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Twilio WhatsApp Sender (Twilio Sandbox or approved number)
# Sandbox default: +14155238886
TWILIO_WHATSAPP_FROM=+14155238886

# Your bakery's WhatsApp number (without the +)
BAKERY_PHONE=919401439292

# Admin secret to view orders at GET /api/orders?secret=...
ADMIN_SECRET=change_this_to_a_strong_secret

# Server port
PORT=3000
